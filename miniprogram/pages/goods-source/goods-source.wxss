/* pages/goods-source/goods-source.wxss 商品来源 */
.page {
  padding: 28rpx 28rpx 60rpx;
}

.head-card {
  margin-bottom: 24rpx;
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.head-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #222;
}

.head-unit {
  font-size: 26rpx;
  color: #999;
}

.source-card {
  padding: 32rpx;
}

.source-title {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.source-label {
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 12rpx;
}

.source-label.invoice {
  color: #07c160;
}

.source-label.purchase {
  color: #576b95;
}

.source-label.unknown {
  color: #bbb;
}

.source-label.restore {
  color: #576b95;
}

.source-line {
  font-size: 27rpx;
  color: #666;
  line-height: 1.7;
}

.source-hint {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #bbb;
}

.source-link {
  margin-top: 24rpx;
  display: inline-block;
  font-size: 27rpx;
  color: #07c160;
  padding: 14rpx 28rpx;
  border: 2rpx solid #07c160;
  border-radius: 12rpx;
}

/* 重建来源（旧商品无 source 时显示） */
.rebuild-btn {
  margin-top: 20rpx;
  display: inline-block;
  margin-left: 20rpx;
  font-size: 27rpx;
  color: #fa8c16;
  padding: 14rpx 28rpx;
  border: 2rpx solid #ffd591;
  border-radius: 12rpx;
}

/* 该商品全部进货记录 */
.src-list-card {
  padding: 8rpx 0;
}

.src-list-title {
  font-size: 26rpx;
  color: #999;
  padding: 20rpx 32rpx 8rpx;
}

.src-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  border-top: 2rpx solid #f5f5f5;
}

.src-row:active {
  background: #fafafa;
}

.src-row-info {
  flex: 1;
  min-width: 0;
}

.src-row-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.src-row-supplier {
  font-size: 28rpx;
  color: #333;
}

.src-tag {
  font-size: 20rpx;
  color: #07c160;
  border: 2rpx solid #07c160;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.src-row-sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.src-row-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.src-row-amount {
  font-size: 28rpx;
  color: #fa5151;
  font-weight: 500;
}

.src-row-arrow {
  font-size: 36rpx;
  color: #ccc;
}

/* 发票在回收站 / 已彻底删除：整行灰化 + 灰色状态标签 */
.src-row.row-trash,
.src-row.row-voided {
  opacity: 0.55;
  background: #fafafa;
}

.src-tag-status {
  color: #888;
  border-color: #ccc;
}
