/* pages/profile/profile.wxss 我的 */
.page {
  padding: 40rpx 24rpx 60rpx;
}

.user-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-bottom: 24rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.user-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #07c160;
  color: #fff;
  font-size: 48rpx;
}

.user-info {
  flex: 1;
}

.user-nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #111;
}

.menu-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.menu-text-col {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.menu-text {
  font-size: 30rpx;
  color: #333;
}

.menu-sub {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
  line-height: 1.5;
  word-break: break-all;
}

.menu-sub-empty {
  color: #aaa;
}

.menu-arrow {
  font-size: 40rpx;
  color: #ccc;
  flex-shrink: 0;
}

/* 识别设置弹窗：模型选择行 */
.rec-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
  margin-bottom: 16rpx;
}

.rec-row-label {
  font-size: 28rpx;
  color: #333;
}

.rec-row-value {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #666;
  font-size: 26rpx;
}

.rec-row-arrow {
  color: #ccc;
  font-size: 32rpx;
}

.rec-key-label {
  margin-bottom: 12rpx;
}

.rec-key-margin {
  margin-top: 28rpx;
}

/* 编辑资料弹窗：头像选择（view 固定圆形 + 透明按钮负责 chooseAvatar 触发） */
.avatar-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #f5f5f5;
  margin: 0 auto;
}

.avatar-wrap-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
  background: #fff;
}

.avatar-wrap-empty {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  box-sizing: border-box;
  border: 2rpx dashed #ccc;
  color: #999;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.avatar-picker-btn {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  z-index: 2;
  margin: 0;
  padding: 0;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-panel {
  width: 640rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 32rpx 28rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 28rpx;
}

.modal-textarea {
  width: 100%;
  height: 200rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  margin-bottom: 32rpx;
}

.modal-input {
  height: 80rpx;
  line-height: 80rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.modal-tip {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  border-radius: 12rpx;
  padding: 20rpx 0;
  line-height: 1.4;
}

.modal-cancel {
  background: #f2f2f2;
  color: #666;
}

.modal-ok {
  background: #07c160;
  color: #fff;
}

.logout-card {
  text-align: center;
  padding: 28rpx;
}

.logout-text {
  font-size: 30rpx;
  color: #fa5151;
}

.tip {
  font-size: 22rpx;
  color: #bbb;
  text-align: center;
  margin-top: 32rpx;
  line-height: 1.6;
}

/* 联系作者：整行可点，复制邮箱 */
.contact {
  margin-top: 40rpx;
  text-align: center;
}

.contact:active {
  opacity: 0.6;
}

.contact-text {
  display: block;
  font-size: 24rpx;
  color: #999;
}
