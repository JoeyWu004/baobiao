/* pages/map/map.wxss 地图 */
.map-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 顶部状态筛选 */
.filter-bar {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #fff;
}

.filter-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 26rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid #eee;
}

.chip-count {
  font-size: 22rpx;
  color: #999;
  background: rgba(0, 0, 0, 0.06);
  border-radius: 20rpx;
  padding: 2rpx 12rpx;
}

.chip-active {
  background: #07c160;
  color: #fff;
  border-color: #07c160;
}

.chip-active .chip-count {
  color: #fff;
  background: rgba(255, 255, 255, 0.25);
}

/* 地图区域 */
.map-wrap {
  position: relative;
  flex: 1;
}

.map {
  width: 100%;
  height: 100%;
}

.map-empty {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(255, 255, 255, 0.92);
  border-radius: 12rpx;
  padding: 24rpx 36rpx;
  font-size: 26rpx;
  color: #666;
  text-align: center;
  max-width: 80%;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

/* 竖排圆形图标按钮组：右下角，从上到下 */
.map-actions {
  position: absolute;
  right: 20rpx;
  bottom: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  align-items: center;
}

.map-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.96);
  color: #333;
  font-size: 30rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.15);
}

.map-btn-primary {
  color: #07c160;
}
