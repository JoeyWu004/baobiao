<!--pages/quantity-history/quantity-history.wxml 数量变动记录-->
<view class="page">
  <view class="filter-bar">
    <view class="filter-chip {{filter === 'all' ? 'chip-active' : ''}}" data-filter="all" bindtap="setFilter">全部</view>
    <view class="filter-chip {{filter === 'manual' ? 'chip-active' : ''}}" data-filter="manual" bindtap="setFilter">手动</view>
    <view class="filter-chip {{filter === 'invoice' ? 'chip-active' : ''}}" data-filter="invoice" bindtap="setFilter">发票</view>
    <view class="filter-chip {{filter === 'report' ? 'chip-active' : ''}}" data-filter="report" bindtap="setFilter">报表</view>
  </view>

  <view class="rebuild-bar">
    <view class="rebuild-btn" bindtap="onRebuildQty">重建数量记录（含手动）</view>
    <view class="rebuild-tip">按全部记录重算库存并保留记录；是否删除旧手动记录由你自行处理</view>
  </view>

  <view
    class="card hist-card {{item.rowClass}}"
    wx:for="{{list}}"
    wx:key="_id"
    wx:if="{{filter === 'all' || item.group === filter}}"
    data-id="{{item._id}}"
    data-source="{{item.source}}"
    data-purchase-id="{{item.purchaseId}}"
    data-purchase-state="{{item.purchaseState}}"
    data-report-id="{{item.reportId}}"
    bindtap="onCardTap"
    bindlongpress="onDeleteRecord"
  >
    <view class="hist-top">
      <text class="hist-time">{{item.timeText}}</text>
      <view class="hist-tags">
        <text class="hist-unit" wx:if="{{item.unit}}">{{item.unit}}</text>
        <text class="hist-source">{{item.sourceText}}</text>
        <text class="hist-status" wx:if="{{item.statusText}}">{{item.statusText}}</text>
        <text class="hist-go" wx:if="{{item.linkable}}">查看 ›</text>
      </view>
    </view>
    <view class="hist-change">
      <text class="hist-delta {{item.deltaClass}}">{{item.deltaText}} {{item.unit}}</text>
      <text class="hist-arrow">→</text>
      <text class="hist-after">库存 {{item.afterText}} {{item.unit}}</text>
    </view>
  </view>

  <!-- 补齐旧发票/进货记录关联 -->
  <view class="backfill-wrap" wx:if="{{pendingCount > 0}}">
    <view class="backfill-btn" bindtap="onLinkBackfill">补齐发票关联</view>
    <view class="backfill-tip">{{pendingCount}} 条发票/进货记录未关联进货明细，点击可按时间就近匹配，之后点记录可直达来源</view>
  </view>

  <view class="empty" wx:if="{{!loading && list.length === 0}}">暂无数量变动记录</view>
  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <!-- 交互说明 -->
  <view class="hist-hint" wx:if="{{list.length > 0}}">点击发票/进货/报表记录可查看来源；长按可删除</view>
</view>
