/* pages/category/category.wxss 分类管理 */
.page {
  padding: 24rpx 24rpx 60rpx;
}

.toolbar {
  margin-bottom: 24rpx;
}

.add-root {
  padding: 20rpx 0;
}

.cat-row {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  background: #fff;
  border-radius: 14rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 10rpx;
  min-width: 0;
}

/* 层级色点：一级绿 / 二级蓝 / 三级橙 / 更深紫 */
.cat-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.dot-0 { background: #07c160; }
.dot-1 { background: #4a7dff; }
.dot-2 { background: #ff9f2e; }
.dot-3 { background: #8f6fff; }

.cat-name {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  word-break: break-all; /* 允许换行，保证类名始终可见 */
}

/* 一级分类：加粗分组感 */
.cat-root {
  font-size: 32rpx;
  font-weight: 600;
  color: #111;
}

.depth-0 {
  background: #f7fff9;
  border: 2rpx solid #e3f5ea;
  margin-top: 12rpx;
}

.cat-list .depth-0:first-child {
  margin-top: 0;
}

/* 交互说明 */
.cat-hint {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
}

/* 输入弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-panel {
  width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 32rpx 28rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 28rpx;
}

.modal-input {
  height: 80rpx;
  line-height: 80rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  margin-bottom: 32rpx;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  border-radius: 12rpx;
  padding: 20rpx 0;
}

.modal-cancel {
  background: #f2f2f2;
  color: #666;
}

.modal-ok {
  background: #07c160;
  color: #fff;
}
