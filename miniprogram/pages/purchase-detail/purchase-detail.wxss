/* pages/purchase-detail/purchase-detail.wxss 进货明细（可编辑） */
.page {
  padding: 28rpx 28rpx 80rpx;
}

.head-card {
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.head-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.head-label {
  width: 120rpx;
  font-size: 28rpx;
  color: #555;
  flex-shrink: 0;
}

.head-total {
  font-size: 32rpx;
  font-weight: 700;
  color: #fa5151;
}

.date-value {
  height: 76rpx;
  line-height: 76rpx;
  background: #f7f7f7;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.items {
  margin-bottom: 20rpx;
}

.item-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
  color: #999;
  padding: 0 8rpx 12rpx;
}

.col-name { flex: 2; padding-left: 12rpx; }
.col-unit { flex: 0.9; text-align: center; }
.col-qty { flex: 0.9; text-align: center; }
.col-price { flex: 1; text-align: center; }
.col-amount { flex: 1.2; text-align: right; padding-right: 12rpx; }

.item-card {
  margin-bottom: 16rpx;
  padding: 20rpx 24rpx;
}

.item-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.item-name-wrap {
  flex: 2;
  position: relative;
  display: flex;
  align-items: center;
  height: 60rpx;
  line-height: 60rpx;
  background: #f7f7f7;
  border-radius: 8rpx;
  overflow: hidden;
}

.item-name {
  flex: 1;
  height: 60rpx;
  line-height: 60rpx;
  background: transparent;
  padding: 0 44rpx 0 12rpx;
  font-size: 26rpx;
}

.item-del {
  position: absolute;
  right: 4rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 26rpx;
  color: #fa5151;
}

.item-input {
  height: 60rpx;
  line-height: 60rpx;
  background: #f7f7f7;
  border-radius: 8rpx;
  padding: 0 4rpx;
  font-size: 26rpx;
  text-align: center;
}

.unit { flex: 0.9; }
.qty { flex: 0.9; }
.price { flex: 1; }

.item-amount {
  flex: 1.2;
  text-align: right;
  font-size: 28rpx;
  color: #fa5151;
  font-weight: 500;
}

.add-row-btn {
  margin-bottom: 32rpx;
}

.img-card {
  margin-bottom: 24rpx;
}

.img-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.inv-img {
  width: 100%;
  border-radius: 10rpx;
}

.save-btn {
  width: 100%;
  margin-bottom: 20rpx;
}

.report-btn {
  width: 100%;
}
