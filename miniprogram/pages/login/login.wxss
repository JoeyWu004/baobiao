/* pages/login/login.wxss 登录页 */
.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  background: linear-gradient(180deg, #eafaf0 0%, #f6f6f6 60%);
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 32rpx;
  background: #07c160;
  color: #fff;
  font-size: 72rpx;
  font-weight: 700;
  text-align: center;
  line-height: 140rpx;
  box-shadow: 0 12rpx 32rpx rgba(7, 193, 96, 0.35);
}

.app-name {
  font-size: 44rpx;
  font-weight: 600;
  color: #111;
  margin-top: 28rpx;
}

/* 首次登录引导：完善资料卡片 */
.profile-card {
  width: 100%;
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
  box-sizing: border-box;
}

.profile-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
  align-self: flex-start;
}

.avatar-wrap {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #f5f5f5;
  margin-bottom: 28rpx;
}

.avatar-wrap-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
  background: #fff;
}

.avatar-wrap-empty {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  box-sizing: border-box;
  border: 2rpx dashed #ccc;
  color: #999;
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-picker-btn {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  z-index: 2;
  margin: 0;
  padding: 0;
}

.nick-input {
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.profile-tip {
  font-size: 22rpx;
  color: #aaa;
  margin-top: 16rpx;
  text-align: center;
  line-height: 1.6;
}

.login-btn {
  width: 100%;
  background: #07c160;
  color: #fff;
  border-radius: 14rpx;
  font-size: 34rpx;
  font-weight: 500;
  text-align: center;
  padding: 26rpx 0;
}

.login-btn:active {
  opacity: 0.85;
}

.privacy-tip {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 32rpx;
  text-align: center;
}
