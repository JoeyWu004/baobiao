<!--pages/price-history/price-history.wxml 价格历史-->
<view class="page">
  <!-- 价格变动图表（常驻） -->
  <view class="card chart-card">
    <view class="chart-title">价格变动</view>
    <view class="chart-wrap">
      <canvas type="2d" id="priceChart" class="price-chart"></canvas>
      <text class="chart-empty" wx:if="{{!hasData && !loading}}">暂无价格变动数据</text>
    </view>
  </view>

  <!-- 从最近报表同步售价 -->
  <view class="sync-bar" wx:if="{{productId}}">
    <view
      class="sync-btn {{syncing ? 'sync-disabled' : ''}}"
      bindtap="onSyncPrice"
    >同步最近售价</view>
    <view class="sync-tip">把最近一次报表售价同步到本商品售价，并补一条价格历史</view>
  </view>

  <!-- 筛选：全部 / 售价 / 进价 -->
  <view class="filter-bar">
    <view
      class="filter-chip {{filter === 'all' ? 'chip-active' : ''}}"
      data-filter="all"
      bindtap="setFilter"
    >全部</view>
    <view
      class="filter-chip {{filter === 'sell' ? 'chip-active' : ''}}"
      data-filter="sell"
      bindtap="setFilter"
    >售价</view>
    <view
      class="filter-chip {{filter === 'cost' ? 'chip-active' : ''}}"
      data-filter="cost"
      bindtap="setFilter"
    >进价</view>
  </view>

  <!-- 历史记录 -->
  <view
    class="card history-card"
    wx:for="{{list}}"
    wx:key="_id"
    wx:if="{{filter === 'all' || item.priceType === filter}}"
    data-id="{{item._id}}"
    data-source="{{item.source}}"
    data-purchase-id="{{item.purchaseId}}"
    data-report-id="{{item.reportId}}"
    bindtap="onCardTap"
    bindlongpress="onDeleteRecord"
  >
    <view class="history-top">
      <text class="history-time">{{item.timeText}}</text>
      <view class="history-tags">
        <text class="history-unit" wx:if="{{item.unit}}">{{item.unit}}</text>
        <text class="history-type {{item.typeClass}}">{{item.typeLabel}}</text>
        <text class="history-source" wx:if="{{item.sourceText}}">{{item.sourceText}}</text>
        <text class="history-go" wx:if="{{item.linkable}}">查看 ›</text>
      </view>
    </view>
    <view class="history-change">
      <text class="old">¥{{item.oldText}}</text>
      <text class="arrow">→</text>
      <text class="new">¥{{item.newText}}</text>
    </view>
  </view>

  <!-- 补齐旧记录来源 -->
  <view class="backfill-wrap" wx:if="{{pendingCount > 0}}">
    <view class="backfill-btn" bindtap="onBackfillLinks">补齐价格来源</view>
    <view class="backfill-tip">{{pendingCount}} 条记录尚未标注来源，点击可按时间就近匹配报表/进货</view>
  </view>

  <view class="empty" wx:if="{{!loading && list.length === 0}}">暂无价格变动记录</view>
  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <!-- 交互说明 -->
  <view class="hist-hint" wx:if="{{list.length > 0}}">点击报表/发票/进货引起的价格变化可查看来源；长按记录可删除</view>
</view>
