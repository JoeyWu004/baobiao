<!--pages/changelog/changelog.wxml 更新日志-->
<view class="page">
  <view class="hero">
    <view class="hero-label">当前版本</view>
    <view class="hero-version">{{currentVersion}}</view>
    <view class="hero-date" wx:if="{{latestDate}}">最近更新 {{latestDate}}</view>
  </view>

  <view class="card ver-card" wx:for="{{versions}}" wx:key="version">
    <view class="ver-head">
      <view class="ver-dot"></view>
      <text class="ver-name">{{item.version}}</text>
      <text class="ver-date">{{item.date}}</text>
    </view>
    <view class="ver-item" wx:for="{{item.items}}" wx:for-item="sub" wx:key="text">
      <text class="tag {{sub.cls}}">{{sub.type}}</text>
      <text class="ver-text">{{sub.text}}</text>
    </view>
  </view>

  <view class="tip">v1.2.2 之前的版本未留存记录。</view>
</view>
