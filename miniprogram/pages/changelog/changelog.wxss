/* pages/changelog/changelog.wxss 更新日志 */
.page {
  padding: 32rpx 24rpx 60rpx;
}

/* 顶部当前版本 */
.hero {
  background: linear-gradient(135deg, #07c160, #06ad56);
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  color: #fff;
  margin-bottom: 24rpx;
}

.hero-label {
  font-size: 24rpx;
  opacity: 0.85;
}

.hero-version {
  font-size: 52rpx;
  font-weight: 600;
  margin: 8rpx 0 4rpx;
  letter-spacing: 2rpx;
}

.hero-date {
  font-size: 24rpx;
  opacity: 0.85;
}

/* 每个版本一张卡 */
.ver-card {
  margin-bottom: 24rpx;
}

.ver-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f5f5f5;
  margin-bottom: 8rpx;
}

.ver-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #07c160;
  flex-shrink: 0;
}

.ver-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #111;
}

.ver-date {
  font-size: 24rpx;
  color: #999;
  margin-left: auto;
}

/* 条目：类型标签 + 说明，标签固定宽度以免说明文字参差 */
.ver-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 14rpx 0;
}

.tag {
  flex-shrink: 0;
  width: 76rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 34rpx;
  border-radius: 8rpx;
  margin-top: 4rpx;
}

.tag-add {
  color: #07c160;
  background: rgba(7, 193, 96, 0.1);
}

.tag-opt {
  color: #1989fa;
  background: rgba(25, 137, 250, 0.1);
}

.tag-fix {
  color: #ff976a;
  background: rgba(255, 151, 106, 0.12);
}

.ver-text {
  flex: 1;
  font-size: 27rpx;
  color: #444;
  line-height: 1.6;
}

.tip {
  font-size: 22rpx;
  color: #bbb;
  text-align: center;
  margin-top: 32rpx;
  line-height: 1.6;
}
