/**app.wxss**/
page {
  background: #f6f6f6;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC",
    "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

button {
  background: initial;
  padding: 0;
  margin: 0;
  border-radius: 0;
  line-height: 1.4;
}

button::after {
  border: none;
}

view,
text,
input,
button,
textarea,
scroll-view {
  box-sizing: border-box;
}

/* 通用卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* 通用主按钮 */
.btn-primary {
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  padding: 24rpx 0;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-disabled {
  opacity: 0.5;
}

/* 通用次级按钮 */
.btn-plain {
  border: 2rpx solid #07c160;
  color: #07c160;
  border-radius: 12rpx;
  font-size: 30rpx;
  text-align: center;
  padding: 16rpx 0;
}

/* 输入框 */
.input-box {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  background: #f7f7f7;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 120rpx 0;
}
