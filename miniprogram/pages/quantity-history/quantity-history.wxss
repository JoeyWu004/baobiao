/* pages/quantity-history/quantity-history.wxss 数量变动记录 */
.page {
  padding: 24rpx 24rpx 60rpx;
}

.filter-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.filter-chip {
  padding: 12rpx 28rpx;
  background: #fff;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid #eee;
}

.chip-active {
  background: #07c160;
  color: #fff;
  border-color: #07c160;
}

.rebuild-bar {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.rebuild-btn {
  width: 100%;
  box-sizing: border-box;
  text-align: center;
  padding: 18rpx 0;
  background: #fff7e6;
  color: #fa8c16;
  border: 2rpx solid #ffd591;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.rebuild-tip {
  font-size: 22rpx;
  color: #bbb;
}

.hist-card {
  margin-bottom: 16rpx;
}

.hist-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.hist-time {
  font-size: 24rpx;
  color: #999;
}

.hist-tags {
  display: flex;
  gap: 10rpx;
}

.hist-unit {
  font-size: 22rpx;
  color: #07c160;
  background: #eafaf0;
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
}

.hist-source {
  font-size: 22rpx;
  color: #576b95;
  background: #eceff8;
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
}

.hist-change {
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 30rpx;
}

.hist-delta {
  font-weight: 600;
}

.hist-delta.up {
  color: #07c160;
}

.hist-delta.down {
  color: #fa5151;
}

.hist-arrow {
  color: #ccc;
  font-size: 26rpx;
}

.hist-after {
  color: #666;
  font-size: 26rpx;
}

/* 可点击跳转标识 */
.hist-go {
  font-size: 22rpx;
  color: #576b95;
  margin-left: 2rpx;
}

/* 补齐旧发票关联 */
.backfill-wrap {
  margin-top: 8rpx;
  margin-bottom: 8rpx;
}

.backfill-btn {
  width: 100%;
  box-sizing: border-box;
  text-align: center;
  padding: 18rpx 0;
  background: #eafaf0;
  color: #07c160;
  border: 2rpx solid #b7eccd;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.backfill-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #bbb;
  text-align: center;
}

/* 交互说明 */
.hist-hint {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
}
