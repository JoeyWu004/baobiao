/* pages/invoice-confirm/invoice-confirm.wxss 发票确认 */
.page {
  padding: 24rpx 24rpx 80rpx;
}

.stepper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.step-btn {
  font-size: 26rpx;
  color: #07c160;
  padding: 10rpx 20rpx;
  border: 2rpx solid #07c160;
  border-radius: 10rpx;
}

.step-disabled {
  color: #ccc;
  border-color: #eee;
}

.step-info {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.head-card {
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 识别模型标注（这张图是哪个模型识别的） */
.model-tag {
  align-self: flex-start;
  font-size: 23rpx;
  color: #666;
  background: #f5f6f8;
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
}

.head-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.head-label {
  width: 120rpx;
  font-size: 28rpx;
  color: #555;
  flex-shrink: 0;
}

.date-value {
  height: 76rpx;
  line-height: 76rpx;
  background: #f7f7f7;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.items {
  margin-bottom: 20rpx;
}

.item-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
  color: #999;
  padding: 0 8rpx 12rpx;
}

.col-name { flex: 2; padding-left: 12rpx; }
.col-unit { flex: 0.9; text-align: center; }
.col-qty { flex: 0.9; text-align: center; }
.col-price { flex: 1; text-align: center; }
.col-amount { flex: 1.2; text-align: right; padding-right: 12rpx; }

.item-card {
  margin-bottom: 16rpx;
  padding: 20rpx 24rpx;
}

.item-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.item-name-wrap {
  flex: 2;
  position: relative;
  display: flex;
  align-items: center;
  height: 60rpx;
  line-height: 60rpx;
  background: #f7f7f7;
  border-radius: 8rpx;
  overflow: hidden;
}

.item-name {
  flex: 1;
  height: 60rpx;
  line-height: 60rpx;
  background: transparent;
  padding: 0 44rpx 0 12rpx;
  font-size: 26rpx;
}

.item-del {
  position: absolute;
  right: 4rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 26rpx;
  color: #fa5151;
}

.item-input {
  height: 60rpx;
  line-height: 60rpx;
  background: #f7f7f7;
  border-radius: 8rpx;
  padding: 0 4rpx;
  font-size: 26rpx;
  text-align: center;
}

.unit { flex: 0.9; }
.qty { flex: 0.9; }
.price { flex: 1; }

.item-amount {
  flex: 1.2;
  text-align: right;
  font-size: 28rpx;
  color: #fa5151;
  font-weight: 500;
}

.add-row-btn {
  margin-bottom: 32rpx;
}

.ops {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.op-btn {
  width: 100%;
}

.op-btn-danger {
  border-color: #f0d0d0;
  color: #fa5151;
}

.tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 28rpx;
  text-align: center;
  line-height: 1.6;
}

.img-card {
  margin-bottom: 24rpx;
}

.img-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.inv-img {
  width: 100%;
  border-radius: 10rpx;
}
