/* pages/quantity-history/quantity-history.wxss 数量变动记录 */
.page {
  padding: 24rpx 24rpx 60rpx;
}

.filter-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.filter-chip {
  padding: 12rpx 28rpx;
  background: #fff;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid #eee;
}

.chip-active {
  background: #07c160;
  color: #fff;
  border-color: #07c160;
}

.hist-card {
  margin-bottom: 16rpx;
}

.hist-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.hist-time {
  font-size: 24rpx;
  color: #999;
}

.hist-tags {
  display: flex;
  gap: 10rpx;
}

.hist-unit {
  font-size: 22rpx;
  color: #07c160;
  background: #eafaf0;
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
}

.hist-source {
  font-size: 22rpx;
  color: #576b95;
  background: #eceff8;
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
}

.hist-change {
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 30rpx;
}

.hist-delta {
  font-weight: 600;
}

.hist-delta.up {
  color: #07c160;
}

.hist-delta.down {
  color: #fa5151;
}

.hist-arrow {
  color: #ccc;
  font-size: 26rpx;
}

.hist-after {
  color: #666;
  font-size: 26rpx;
}

/* 交互说明 */
.hist-hint {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
}
