/* pages/price-history/price-history.wxss 价格历史 */
.page {
  padding: 24rpx 24rpx 60rpx;
}

/* 价格变动图表 */
.chart-card {
  padding: 24rpx 16rpx 16rpx;
  margin-bottom: 24rpx;
}

.chart-title {
  font-size: 26rpx;
  color: #666;
  margin: 0 8rpx 12rpx;
}

.chart-wrap {
  position: relative;
  height: 360rpx;
}

.price-chart {
  width: 100%;
  height: 100%;
}

.chart-empty {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 24rpx;
  color: #ccc;
}

/* 交互说明 */
.hist-hint {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
}

/* 从最近报表同步售价 */
.sync-bar {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.sync-btn {
  width: 100%;
  box-sizing: border-box;
  text-align: center;
  padding: 18rpx 0;
  background: #fff7e6;
  color: #fa8c16;
  border: 2rpx solid #ffd591;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.sync-disabled {
  opacity: 0.6;
}

.sync-tip {
  font-size: 22rpx;
  color: #bbb;
}

.filter-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.filter-chip {
  padding: 12rpx 32rpx;
  background: #fff;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid #eee;
}

.chip-active {
  background: #07c160;
  color: #fff;
  border-color: #07c160;
}

.history-card {
  margin-bottom: 16rpx;
}

.history-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.history-time {
  font-size: 24rpx;
  color: #999;
}

.history-tags {
  display: flex;
  gap: 10rpx;
}

.history-unit {
  font-size: 22rpx;
  color: #07c160;
  background: #eafaf0;
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
}

.history-type {
  font-size: 22rpx;
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
}

.tag-sell {
  color: #fa5151;
  background: #fdecec;
}

.tag-cost {
  color: #576b95;
  background: #eceff8;
}

.history-change {
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 32rpx;
}

.old {
  color: #999;
  text-decoration: line-through;
}

.arrow {
  color: #ccc;
  font-size: 28rpx;
}

.new {
  color: #fa5151;
  font-weight: 600;
}

/* 来源标签 / 可点击标识 */
.history-source {
  font-size: 22rpx;
  color: #576b95;
  background: #eceff8;
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
}

.history-go {
  font-size: 22rpx;
  color: #576b95;
}

/* 来源发票在回收站 / 已彻底删除：整卡灰化 + 状态标签 */
.history-card.row-trash,
.history-card.row-voided {
  opacity: 0.55;
  background: #f7f7f7;
}

/* 已作废的新价加删除线（.old 本身已有删除线，表示「被取代」） */
.history-card.row-voided .new {
  text-decoration: line-through;
}

.history-status {
  font-size: 22rpx;
  color: #888;
  background: #ededed;
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
}

/* 补齐旧记录来源 */
.backfill-wrap {
  margin-bottom: 8rpx;
}

.backfill-btn {
  width: 100%;
  box-sizing: border-box;
  text-align: center;
  padding: 18rpx 0;
  background: #eafaf0;
  color: #07c160;
  border: 2rpx solid #b7eccd;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.backfill-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #bbb;
  text-align: center;
}
