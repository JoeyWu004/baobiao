/* components/goods-picker/index.wxss */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.picker-panel {
  width: 100%;
  height: 70vh; /* 固定高度 */
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 16rpx;
}

.picker-title {
  font-size: 34rpx;
  font-weight: 600;
}

.picker-close {
  font-size: 28rpx;
  color: #07c160;
  padding: 8rpx 16rpx;
}

.picker-search {
  padding: 8rpx 32rpx 20rpx;
}

.picker-input {
  height: 68rpx;
  line-height: 68rpx;
  background: #f7f7f7;
  border-radius: 10rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.picker-cats {
  white-space: nowrap;
  padding: 0 32rpx 16rpx;
}

.picker-cat {
  display: inline-block;
  padding: 10rpx 26rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 28rpx;
}

.picker-cat.cat-active {
  background: #eafaf0;
  color: #07c160;
  font-weight: 500;
}

.picker-list {
  flex: 1; /* 占满剩余高度 */
  min-height: 0;
}

.picker-item {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 2rpx solid #f2f2f2;
}

.picker-item-selected {
  background: #f7fbf8;
}

.picker-item:active {
  background: #fafafa;
}

.picker-item-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  margin-right: 20rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 26rpx;
  box-sizing: border-box;
}

.picker-item-check.checked {
  background: #07c160;
  border-color: #07c160;
}

.picker-item-main {
  flex: 1;
  min-width: 0;
}

.picker-item-name {
  font-size: 30rpx;
  color: #222;
}

.picker-item-unit {
  font-size: 22rpx;
  color: #999;
  margin-left: 12rpx;
}

.picker-item-supplier {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.picker-item-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.picker-item-price {
  font-size: 30rpx;
  color: #fa5151;
  font-weight: 500;
}

.picker-item-cost {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.picker-empty {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 80rpx 0;
}
